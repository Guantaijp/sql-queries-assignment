-- Q6: Write a CTE that calculates the average sales per customer and then returns customers whose total sales are above that average.

with customer_sales as (
    select 
        ci.full_name, 
        sum(s.total_sales) as total_amount_spent
    from sales s
    join customer_info ci 
        on s.customer_id = ci.customer_id
    group by ci.full_name
),
average_sales as (
    select avg(total_amount_spent) as avg_sales
    from customer_sales
)
select 
    cs.full_name, 
    cs.total_amount_spent
from customer_sales cs, average_sales a
where cs.total_amount_spent > a.avg_sales;



-- Q7: Write a Window Function query that ranks products by their total sales in descending order. Display product_name, total_sales, and rank.
-- select * from sales;

select
  p.product_name,
  sum(s.total_sales) as total_sales,
  rank() over (order by sum(s.total_sales) desc) as total_sales_rank
from sales s
join products p on s.product_id = p.product_id
group by p.product_name
order by total_sales desc, p.product_name;

-- Q8: Create a View called high_value_customers that lists all customers with total sales greater than 15,000.

create view high_value_customers as
select 
    ci.customer_id,
    ci.full_name,
    sum(s.total_sales) as total_amount_spent
from sales s
join customer_info ci 
    on s.customer_id = ci.customer_id
group by ci.customer_id, ci.full_name
having sum(s.total_sales) > 15000;

select * from high_value_customers;

-- Q9: Create a Stored Procedure that accepts a location as input and returns all customers and their total spending from that location.
create procedure get_customers_by_location(in p_location varchar(255))
begin
    select 
        ci.customer_id,
        ci.full_name,
        ci.location,
        sum(s.total_sales) as total_spending
    from sales s
    join customer_info ci 
        on s.customer_id = ci.customer_id
    where ci.location = p_location
    group by ci.customer_id, ci.full_name, ci.location;
end

call get_customers_by_location('Nairobi');


-- Q10: Write a recursive query to display all sales transactions in order by sales_id, along with a running total of sales.

WITH RECURSIVE sales_running_total AS (
  -- Anchor: first row only
  SELECT sales_id, total_sales, total_sales AS running_total
  FROM sales
  WHERE sales_id = (SELECT MIN(sales_id) FROM sales)

  UNION ALL

  -- Recursive: next row based on higher sales_id
  SELECT s.sales_id, s.total_sales, srt.running_total + s.total_sales
  FROM sales s
  JOIN sales_running_total srt
    ON s.sales_id = (
      SELECT MIN(s2.sales_id)
      FROM sales s2
      WHERE s2.sales_id > srt.sales_id
    )
)
SELECT * FROM sales_running_total;


